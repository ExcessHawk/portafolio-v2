---
import '../styles/global.css'
import { site, sections } from '../data/site'
import SocialLink from '../components/SocialLink.astro'

interface Props {
  title?: string
  description?: string
}

const {
  title = `${site.name} — Full-Stack Engineer`,
  description = site.summary,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://alfredomejia.com.mx')
---

<!doctype html>
<html lang="es" class="scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#07090c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
  </head>

  <body class="min-h-dvh antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-signal focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-ink-950"
    >
      Saltar al contenido
    </a>

    <header
      class="sticky top-0 z-40 border-b border-ink-800 bg-ink-950/80 backdrop-blur-md"
    >
      <nav
        aria-label="Principal"
        class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-5"
      >
        <a
          href="#top"
          class="group flex items-center gap-2 font-mono text-sm text-ink-100"
        >
          <span
            class="inline-block size-2 rounded-full bg-signal shadow-[0_0_10px_var(--color-signal)]"
            aria-hidden="true"></span>
          <span class="font-semibold">{site.handle}</span>
          <span class="text-ink-400">.dev</span>
        </a>

        <ul class="hidden items-center gap-1 md:flex">
          {
            sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="group flex items-center gap-1.5 rounded-md px-3 py-1.5 font-mono text-[0.8rem] text-ink-300 transition-colors hover:bg-ink-850 hover:text-ink-100"
                >
                  <span class="text-ink-600 transition-colors group-hover:text-signal">
                    {section.num}
                  </span>
                  {section.label}
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href={`mailto:${site.email}`}
          class="rounded-md border border-ink-700 px-3 py-1.5 font-mono text-[0.8rem] text-ink-200 transition-colors hover:border-signal hover:text-signal"
        >
          Escríbeme
        </a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-ink-800 bg-ink-900">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-8 font-mono text-xs text-ink-400 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>
          {site.name} · {site.location}
        </p>
        <p class="flex flex-wrap items-center gap-5">
          <SocialLink kind="github" href={site.github} />
          <SocialLink kind="linkedin" href={site.linkedin} />
          <SocialLink kind="npm" href={site.npm} label="veloce-ts" />
          <SocialLink kind="mail" href={`mailto:${site.email}`} label="Email" />
        </p>
      </div>
      <div class="border-t border-ink-800/60 px-5 py-4 text-center font-mono text-[0.7rem] text-ink-600">
        Hecho con Astro y Tailwind. El playground corre la aplicación de verdad.
        <a
          href="https://github.com/ExcessHawk/portafolio-v2"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-1 underline decoration-ink-700 underline-offset-4 transition-colors hover:text-signal hover:decoration-signal"
        >
          El código de esta página ↗
        </a>
      </div>
    </footer>
  </body>
</html>
