---
import '../styles/global.css'
import type { Lang } from '../i18n/ui'
import { ui, altPath } from '../i18n/ui'
import { content } from '../i18n/content'
import SocialLink from '../components/SocialLink.astro'

interface Props {
  lang: Lang
  title?: string
  description?: string
}

const { lang, title: titleProp, description: descProp } = Astro.props
const t = ui[lang]
const { site } = content(lang)

const title = titleProp ?? t.meta.title
const description = descProp ?? t.meta.description

const siteUrl = Astro.site ?? new URL('https://alfredomejia.com.mx')
const canonical = new URL(Astro.url.pathname, siteUrl)
const ogImage = new URL('/og.png', siteUrl)

// The same page in both locales, for hreflang and the language toggle.
const esUrl = new URL('/', siteUrl)
const enUrl = new URL('/en/', siteUrl)

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: siteUrl.href,
  jobTitle: 'Full-Stack Engineer',
  email: `mailto:${site.email}`,
  description,
  worksFor: { '@type': 'Organization', name: 'CustomsCity' },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Instituto Tecnológico Superior de Huetamo',
  },
  knowsAbout: ['TypeScript', 'Bun', 'PostgreSQL', 'React', 'Node.js', 'Backend', 'APIs'],
  sameAs: [site.github, site.linkedin, site.npm],
}
---

<!doctype html>
<html lang={t.htmlLang} class="scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#07090c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
  </head>

  <body class="min-h-dvh antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-signal focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-ink-950"
    >
      {t.skip}
    </a>

    <header
      class="sticky top-0 z-40 border-b border-ink-800 bg-ink-950/80 backdrop-blur-md"
    >
      <nav
        aria-label="Principal"
        class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-5"
      >
        <a
          href="#top"
          class="group flex items-center gap-2 font-mono text-sm text-ink-100"
        >
          <span
            class="inline-block size-2 rounded-full bg-signal shadow-[0_0_10px_var(--color-signal)]"
            aria-hidden="true"></span>
          <span class="font-semibold">{site.handle}</span>
          <span class="text-ink-400">.dev</span>
        </a>

        <ul class="hidden items-center gap-1 md:flex">
          {
            t.sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="group flex items-center gap-1.5 rounded-md px-3 py-1.5 font-mono text-[0.8rem] text-ink-300 transition-colors hover:bg-ink-850 hover:text-ink-100"
                >
                  <span class="text-ink-400 transition-colors group-hover:text-signal">
                    {section.num}
                  </span>
                  {section.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="flex items-center gap-2">
          <a
            href={altPath(lang)}
            hreflang={lang === 'es' ? 'en' : 'es'}
            aria-label={t.nav.toggleAria}
            class="rounded-md border border-ink-700 px-2.5 py-1.5 font-mono text-[0.8rem] text-ink-300 transition-colors hover:border-signal hover:text-signal"
          >
            {t.nav.toggleLabel}
          </a>
          <a
            href={`mailto:${site.email}`}
            class="rounded-md border border-ink-700 px-3 py-1.5 font-mono text-[0.8rem] text-ink-200 transition-colors hover:border-signal hover:text-signal"
          >
            {t.nav.write}
          </a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-ink-800 bg-ink-900">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-8 font-mono text-xs text-ink-400 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>
          {site.name} · {site.location}
        </p>
        <p class="flex flex-wrap items-center gap-5">
          <SocialLink kind="github" href={site.github} />
          <SocialLink kind="linkedin" href={site.linkedin} />
          <SocialLink kind="npm" href={site.npm} label="veloce-ts" />
          <SocialLink kind="mail" href={`mailto:${site.email}`} label={t.footer.email} />
        </p>
      </div>
      <div class="border-t border-ink-800/60 px-5 py-4 text-center font-mono text-[0.7rem] text-ink-400">
        {t.footer.made}
        <a
          href="https://github.com/ExcessHawk/portafolio-v2"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-1 underline decoration-ink-700 underline-offset-4 transition-colors hover:text-signal hover:decoration-signal"
        >
          {t.footer.code}
        </a>
      </div>
    </footer>
  </body>
</html>
