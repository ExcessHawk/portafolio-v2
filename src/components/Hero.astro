---
import { site } from '../data/site'
import SocialLink from './SocialLink.astro'

const dim = (text: string) => `<span class="text-ink-600">${text}</span>`
const key = (text: string) => `<span class="text-wire">${text}</span>`
const fn = (text: string) => `<span class="text-ember">${text}</span>`
const val = (text: string) => `<span class="text-signal">${text}</span>`

const codeHtml = [
  dim('// el stock no se vende dos veces'),
  `${key('const')} taken = ${key('await')} tx`,
  '  .update(variants)',
  `  .set({ stock: sql\`stock - ${val('${qty}')}\` })`,
  '  .where(',
  '    and(',
  '      eq(variants.id, line.variantId),',
  `      ${fn('gte')}(variants.stock, qty),`,
  '    ),',
  '  )',
  '  .returning({ id: variants.id })',
  '',
  `${key('if')} (taken.length === ${val('0')}) {`,
  `  ${key('throw')} ${key('new')} ${fn('Conflict')}(${val('&#39;out_of_stock&#39;')})`,
  '}',
].join('\n')


const facts = [
  { label: 'ubicación', value: 'Morelia, MX · remoto' },
  { label: 'ahora', value: 'Full-Stack en CustomsCity' },
  { label: 'publicado', value: 'veloce-ts@3.5.1 en npm' },
]
---

<section id="top" class="relative overflow-hidden border-b border-ink-800">
  <div class="grid-backdrop pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute top-[-18rem] left-1/2 size-[36rem] -translate-x-1/2 rounded-full bg-signal/10 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl gap-12 px-5 pt-20 pb-24 lg:grid-cols-[1.1fr_0.9fr] lg:pt-28">
    <div>
      <p
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-signal/30 bg-signal/5 px-3 py-1 font-mono text-xs text-signal"
      >
        <span class="relative flex size-2">
          <span
            class="absolute inline-flex size-full animate-ping rounded-full bg-signal opacity-60"
          ></span>
          <span class="relative inline-flex size-2 rounded-full bg-signal"></span>
        </span>
        Abierto a oportunidades
      </p>

      <h1 class="text-balance text-5xl leading-[1.05] font-bold tracking-tight text-ink-100 sm:text-6xl">
        Alfredo Mejía<span class="text-signal">.</span>
      </h1>

      <p class="mt-5 max-w-xl text-balance text-xl leading-relaxed text-ink-200">
        {site.tagline}
      </p>

      <p class="mt-4 max-w-xl leading-relaxed text-ink-400">
        Ingeniero en Sistemas Computacionales. Escribo TypeScript sobre Bun y PostgreSQL. Publiqué
        <a href={site.npm} class="text-ink-100 underline decoration-signal/50 underline-offset-4 transition-colors hover:text-signal">Veloce-TS</a>
        en npm y lo uso para construir lo que ves más abajo.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#playground"
          class="group inline-flex items-center gap-2 rounded-lg bg-signal px-5 py-2.5 font-mono text-sm font-semibold text-ink-950 transition-transform hover:-translate-y-0.5"
        >
          Probar un proyecto
          <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </a>
        <a
          href="#proyectos"
          class="inline-flex items-center gap-2 rounded-lg border border-ink-700 px-5 py-2.5 font-mono text-sm text-ink-200 transition-colors hover:border-ink-400 hover:text-ink-100"
        >
          Ver proyectos
        </a>
        <SocialLink kind="github" href={site.github} variant="button" />
      </div>

      <dl class="mt-10 grid gap-x-8 gap-y-3 border-t border-ink-800 pt-6 font-mono text-sm sm:grid-cols-3">
        {
          facts.map((fact) => (
            <div>
              <dt class="text-xs text-ink-600 uppercase tracking-wider">{fact.label}</dt>
              <dd class="mt-1 text-ink-200">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="panel glow-signal self-start overflow-hidden font-mono text-[0.82rem]">
      <div class="panel-head flex items-center gap-2 px-4 py-2.5">
        <span class="size-2.5 rounded-full bg-rose-alert/80"></span>
        <span class="size-2.5 rounded-full bg-ember/80"></span>
        <span class="size-2.5 rounded-full bg-signal/80"></span>
        <span class="ml-2 text-xs text-ink-400">marketplace/checkout.service.ts</span>
      </div>

      <pre class="overflow-x-auto p-4 leading-relaxed text-ink-300"><code set:html={codeHtml} /></pre>

      <div class="border-t border-ink-700 bg-ink-850 px-4 py-2.5 text-xs text-ink-400">
        <span class="text-signal">●</span> 355 pruebas end-to-end en verde
      </div>
    </div>
  </div>
</section>
