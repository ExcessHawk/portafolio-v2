---
interface Props {
  id: string
  num: string
  title: string
  lead?: string
  class?: string
}

const { id, num, title, lead, class: className = '' } = Astro.props
---

<section id={id} class={`mx-auto max-w-6xl scroll-mt-20 px-5 py-20 ${className}`}>
  <header class="mb-10">
    <p class="mb-3 flex items-center gap-3 font-mono text-xs tracking-widest text-ink-400 uppercase">
      <span class="text-signal">{num}</span>
      <span class="h-px w-8 bg-ink-700"></span>
      <span>{title}</span>
    </p>
    <slot name="heading" />
    {lead && <p class="max-w-2xl text-lg leading-relaxed text-ink-300">{lead}</p>}
  </header>

  <slot />
</section>
